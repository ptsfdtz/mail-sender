{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "信使 Mail Sender",
  "version": "2.0.0",
  "identifier": "su.wzj.mail-sender",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "信使 Mail Sender",
        "width": 1180,
        "height": 760,
        "minWidth": 960,
        "minHeight": 640,
        "center": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "shortDescription": "批量发送 HTML 通知邮件",
    "longDescription": "从 Excel 导入收件名单，预览并批量发送面试、录取与未录取 HTML 通知邮件。",
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
